# === Provider 선택 (gemini | ollama) ===
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# === Gemini ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# === Ollama (LLM_PROVIDER/EMBEDDING_PROVIDER=ollama 일 때만) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VERIFY_MODEL=llama3.2:3b
OLLAMA_ROUTE_MODEL=llama3.2:1b

# 임베딩 모델을 바꾸면 차원도 맞춰야 함 (테이블/컬렉션 재생성 필요)
EMBEDDING_DIMENSION=1536

# === Vector DB (docker-compose.yml 기본값과 일치) ===
DATABASE_URL=postgresql://studywave:studywave@localhost:5432/studywave
